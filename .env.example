# LamportPay environment example
#
# JUPITER_API_KEY and BRIDGE_API_KEY must only be used on the backend (server routes / server functions).
# Never expose JUPITER_API_KEY or BRIDGE_API_KEY in frontend code or any VITE_/NEXT_PUBLIC_ variable.
# Never ask users for their seed phrase.
# Never ask users for their private key.
# Bridge API is optionally enabled by adding a real BRIDGE_API_KEY. When missing, Bridge endpoints return demo-mode responses.
# Fiat payout is intentionally disabled for now.
# Real KYC is intentionally disabled for now.
#
# If JUPITER_API_KEY is missing, the API routes return: "Missing Jupiter API key."
# If BRIDGE_API_KEY is missing, the Bridge API routes return a 503 demo-mode response.

JUPITER_API_KEY=
BRIDGE_API_KEY=
# Optional: sandbox or production URL. Defaults to https://api.bridge.xyz
BRIDGE_API_URL=
# Optional: PEM public key Bridge assigns to your webhook endpoint for signature verification.
BRIDGE_WEBHOOK_PUBLIC_KEY=

# Public (safe to expose) — Solana network used by the wallet provider.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta